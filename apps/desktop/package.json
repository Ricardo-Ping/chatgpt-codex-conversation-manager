{
  "name": "@conversation-manager/desktop",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "description": "Conversation management for ChatGPT and Codex",
  "author": "Ricardo-Ping (https://github.com/Ricardo-Ping)",
  "license": "MIT",
  "homepage": "https://github.com/Ricardo-Ping/chatgpt-codex-conversation-manager#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ricardo-Ping/chatgpt-codex-conversation-manager.git"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run --exclude \"dist/**\"",
    "dev": "pnpm -w build && electron .",
    "start": "electron .",
    "package:win": "pnpm -w build && electron-builder --win nsis portable",
    "package:mac": "pnpm -w build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@conversation-manager/chatgpt-bridge-server": "workspace:*",
    "@conversation-manager/codex-app-server-adapter": "workspace:*",
    "@conversation-manager/conversation-domain": "workspace:*",
    "@tanstack/react-virtual": "^3.14.11",
    "dompurify": "^3.4.15",
    "echarts": "^6.1.0",
    "electron-updater": "6.8.9",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.ricardoping.cgn.desktop",
    "productName": "Conversation Manager",
    "directories": {
      "output": "../../release"
    },
    "publish": {
      "provider": "github",
      "owner": "Ricardo-Ping",
      "repo": "chatgpt-codex-conversation-manager"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.test.*",
      "src/preload.cjs",
      "package.json",
      "!node_modules/@conversation-manager/*/src/**/*",
      "!node_modules/@conversation-manager/*/tsconfig.json",
      "!node_modules/@conversation-manager/*/dist/**/*.test.*"
    ],
    "extraResources": [
      {
        "from": "../../packages/chatgpt-browser-bridge-extension",
        "to": "chatgpt-browser-bridge-extension",
        "filter": [
          "manifest.json",
          "background.js",
          "content.js",
          "bridge-core.js",
          "popup.html",
          "popup.css",
          "popup.js"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true,
      "icon": "build/icon.png",
      "artifactName": "Conversation-Manager-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "Conversation-Manager-${version}-dmg-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "Conversation-Manager-${version}-setup-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "Conversation-Manager-${version}-portable-${arch}.${ext}"
    }
  }
}
