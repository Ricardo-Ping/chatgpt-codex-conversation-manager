{
  "manifest_version": 3,
  "name": "ChatGPT Conversation Navigator",
  "version": "0.2.3",
  "description": "Navigation, long-chat optimization, and batch conversation management for ChatGPT.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "conversation-manager-core.js",
        "conversation-index-store.js",
        "conversation-manager.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
