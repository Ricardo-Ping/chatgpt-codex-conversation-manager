{
  "manifest_version": 3,
  "name": "Conversation Manager Bridge",
  "version": "0.7.4",
  "description": "Connects your signed-in ChatGPT browser session to Conversation Manager on this computer.",
  "permissions": ["storage", "tabs", "alarms", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "http://127.0.0.1:32147/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Conversation Manager", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["bridge-core.js", "content.js"],
    "run_at": "document_idle"
  }]
}
