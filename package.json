{
  "name": "chatgpt-codex-conversation-navigator-desktop",
  "version": "0.1.0-preview.1",
  "private": true,
  "description": "Desktop conversation navigator for ChatGPT and Codex",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @cgn/desktop dev",
    "start": "pnpm --filter @cgn/desktop start",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "package:win": "pnpm --filter @cgn/desktop package:win"
  },
  "engines": {
    "node": ">=22.12"
  }
}
