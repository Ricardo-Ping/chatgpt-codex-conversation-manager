{
  "name": "chatgpt-codex-conversation-manager",
  "version": "0.5.1",
  "private": true,
  "description": "Local desktop conversation manager for ChatGPT and Codex",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @conversation-manager/desktop dev",
    "start": "pnpm --filter @conversation-manager/desktop start",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "package:bridge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-bridge.ps1",
    "package:win": "pnpm --filter @conversation-manager/desktop package:win && pnpm package:bridge"
  },
  "engines": {
    "node": ">=22.12"
  }
}
